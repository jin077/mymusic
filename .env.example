# docker-compose.yml 이 읽는 비밀값 양식.
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채운다.
#
#   cp .env.example .env        (PowerShell: copy .env.example .env)
#
# .env 는 gitignore 대상이라 커밋되지 않는다.

# MariaDB 관리자 비밀번호
DB_ROOT_PASSWORD=여기에_root_비밀번호

# 애플리케이션이 사용할 DB 계정
DB_USER=practice
DB_PASSWORD=여기에_계정_비밀번호

# JWT 서명키 — HS384 를 쓰므로 최소 48바이트(영문 48자) 이상이어야 한다.
# 짧으면 기동 시 WeakKeyException 이 난다.
JWT_SECRET=여기에_48자_이상의_긴_임의_문자열
