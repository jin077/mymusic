# ─────────────────────────────────────────────────────────────
# 백엔드(Spring Boot) 컨테이너 이미지
#
# 만드는 법 :  docker build -t practice-backend:1.0 .     (backend 폴더에서)
# 실행하는 법:  docker run -d -p 8080:8080 practice-backend:1.0
#
# ⚠️ 비밀값(DB 계정·jwt.secret)은 이미지에 넣지 않는다.
#    이미지는 레지스트리로 공유되므로 비밀이 같이 퍼진다.
#    → 실행할 때 환경변수로 주입한다(application.properties의 relaxed binding 이용).
# ─────────────────────────────────────────────────────────────

# ① 바닥 = 자바 17 실행환경(JRE)이 이미 깔린 리눅스
#    jre  : 실행만 하면 되므로 개발도구(JDK)는 불필요 → 이미지가 작아짐
#    이 한 줄이 "리눅스 설치 + 자바 설치"를 대신한다.
FROM eclipse-temurin:17-jre

# ② 컨테이너 안에서의 작업 폴더. 없으면 자동 생성된다.
#    이후 명령들의 기준 경로가 된다(리눅스니까 C:\ 같은 건 없다).
WORKDIR /app

# ③ 호스트의 jar를 컨테이너 안으로 복사
#    왼쪽 = 내 PC 경로(빌드 컨텍스트 기준), 오른쪽 = 컨테이너 안 경로
#    ⭐ 이 줄이 가장 자주 바뀌므로 맨 아래에 둔다.
#      위쪽 층(①②)은 캐시로 재사용되어 재빌드가 빨라진다.
COPY build/libs/practice-0.0.1-SNAPSHOT.jar app.jar

# ④ "이 컨테이너는 8080을 쓴다"는 문서용 표시.
#    실제로 포트를 여는 건 실행할 때의 -p 옵션이다.
EXPOSE 8080

# ⑤ 컨테이너가 켜지면 실행할 명령.
#    이 프로세스가 컨테이너 안의 PID 1이 되고,
#    이게 끝나면 컨테이너도 종료된다(서버라서 안 끝난다).
ENTRYPOINT ["java", "-jar", "app.jar"]
